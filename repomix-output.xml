          <i data-lucide="layout-dashboard"></i>
          Dashboard
        </a>
        <a href="generate.html" class="sidebar-link">
          <i data-lucide="sparkles"></i>
          Generate Quiz
        </a>
        <a href="records.html" class="sidebar-link active">
          <i data-lucide="bar-chart-3"></i>
          Records
        </a>
      </nav>

      <div class="sidebar-footer">
        <div class="sidebar-user">
          <div class="avatar" id="userAvatar">T</div>
          <div class="sidebar-user-info">
            <div class="sidebar-user-name" id="userName">Teacher</div>
            <div class="sidebar-user-email" id="userEmail">teacher@example.com</div>
          </div>
          <button class="logout-btn" id="logoutBtn" title="Logout">
            <i data-lucide="log-out"></i>
          </button>
        </div>
      </div>
    </aside>

    <!-- MAIN -->
    <main class="main-content">

      <div class="main-header">
        <div class="main-header-left">
          <h1>Student Records</h1>
          <p>All quiz attempts submitted by your students</p>
        </div>
        <button class="refresh-btn" id="refreshBtn">
          <i data-lucide="refresh-cw"></i>
          Refresh
        </button>
      </div>

      <!-- MINI STATS -->
      <div class="mini-stats">
