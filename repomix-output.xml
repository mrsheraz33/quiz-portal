    .sidebar-link.active { background: var(--primary-light); color: var(--primary); }
    .sidebar-link [data-lucide] { width: 19px; height: 19px; }

    .sidebar-footer {
      border-top: 1px solid var(--gray-200);
      padding-top: 16px;
      margin-top: 16px;
    }

    .sidebar-user {
      display: flex;
