          Share this link with your students:
        </label>

        <div class="link-box">
          <input type="text" id="quizLink" readonly />
          <button type="button" class="copy-btn" id="copyBtn">
            <i data-lucide="copy"></i>
            Copy
          </button>
        </div>
      </div>

    </main>

  </div>

  <script src="../js/config.js"></script>
  <script>
    lucide.createIcons();

    // Auth check
    const token = getToken("teacher");
    const user = getUser("teacher");

    if (!token || !user) {
      window.location.href = "login.html";
    } else {
      document.getElementById("userName").textContent = user.name;
      document.getElementById("userEmail").textContent = user.email;
      document.getElementById("userAvatar").textContent = user.name.charAt(0).toUpperCase();
    }

    // Logout
    document.getElementById("logoutBtn").addEventListener("click", () => {
      logout("teacher");
    });

    // Generate form
    const form = document.getElementById("generateForm");
    const submitBtn = document.getElementById("submitBtn");
    const resultBox = document.getElementById("resultBox");

    form.addEventListener("submit", async (e) => {
      e.preventDefault();

      const topic = document.getElementById("topic").value.trim();
      const difficulty = document.getElementById("difficulty").value;
      const questionCount = parseInt(document.getElementById("questionCount").value);
      const timeLimit = parseInt(document.getElementById("timeLimit").value);

      if (!topic || !difficulty || !questionCount || !timeLimit) {
        showAlert("alertBox", "Please fill all fields", "error");
        return;
      }

      if (questionCount < 3 || questionCount > 20) {
        showAlert("alertBox", "Question count must be between 3 and 20", "error");
        return;
      }

      submitBtn.disabled = true;
      submitBtn.innerHTML = '<span class="spinner"></span> Generating with AI...';
      resultBox.classList.remove("show");

      try {
        const data = await apiCall(
          "/quiz/create",
          "POST",
          { topic, difficulty, timeLimit, questionCount },
          "teacher"
        );

        const quiz = data.quiz;

        // Show result
        document.getElementById("resTopic").textContent = quiz.topic;
        document.getElementById("resDifficulty").textContent = quiz.difficulty;
        document.getElementById("resQuestions").textContent = quiz.totalQuestions;
        document.getElementById("resTime").textContent = `${quiz.timeLimit} min`;

        // Full link (frontend base URL + path)
        const baseUrl = window.location.origin + "/";
        const fullLink = baseUrl + "student/register.html?code=" + quiz.quizCode;
        document.getElementById("quizLink").value = fullLink;

        resultBox.classList.add("show");
        lucide.createIcons();

        showAlert("alertBox", "Quiz generated successfully", "success");
      } catch (error) {
        showAlert("alertBox", error.message, "error");
      } finally {
        submitBtn.disabled = false;
        submitBtn.innerHTML = '<i data-lucide="sparkles"></i> Generate Quiz with AI';
        lucide.createIcons();
      }
    });

    // Copy link
    document.getElementById("copyBtn").addEventListener("click", () => {
      const input = document.getElementById("quizLink");
      input.select();
      navigator.clipboard.writeText(input.value);
      const btn = document.getElementById("copyBtn");
      btn.innerHTML = '<i data-lucide="check"></i> Copied';
      lucide.createIcons();
      setTimeout(() => {
        btn.innerHTML = '<i data-lucide="copy"></i> Copy';
        lucide.createIcons();
      }, 1500);
    });
  </script>

</body>
</html>
