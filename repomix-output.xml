            <div class="sidebar-user-email" id="userEmail">-</div>
          </div>
          <button class="logout-btn" id="logoutBtn" title="Logout">
            <i data-lucide="log-out"></i>
          </button>
        </div>
      </div>
    </aside>

    <!-- MAIN -->
    <main class="main-content">

      <div class="main-header">
        <h1 id="greeting">Welcome</h1>
        <p>Track your progress and join new quizzes</p>
      </div>

      <div id="alertBox" class="alert"></div>

      <!-- JOIN QUIZ -->
      <div class="join-card">
        <h2>Join a Quiz</h2>
        <p>Paste the quiz link or code shared by your teacher</p>

        <form class="join-form" id="joinForm">
          <input
            type="text"
            id="quizInput"
            placeholder="Paste quiz link or code (e.g. wl68ru)"
            required
          />
          <button type="submit">
            <i data-lucide="arrow-right"></i>
            Join Quiz
          </button>
        </form>
      </div>

      <!-- STATS -->
      <div class="stats-grid">
        <div class="stat-card">
          <div class="stat-icon purple">
            <i data-lucide="file-text"></i>
          </div>
          <div class="stat-value" id="totalAttempts">0</div>
          <div class="stat-label">Quizzes Attempted</div>
        </div>

        <div class="stat-card">
          <div class="stat-icon green">
            <i data-lucide="target"></i>
          </div>
          <div class="stat-value" id="avgScore">0%</div>
          <div class="stat-label">Average Score</div>
        </div>

        <div class="stat-card">
          <div class="stat-icon amber">
            <i data-lucide="award"></i>
          </div>
          <div class="stat-value" id="bestScore">0%</div>
          <div class="stat-label">Best Score</div>
        </div>
      </div>

      <!-- HISTORY -->
      <h2 class="section-title">Your Attempts</h2>

      <div class="table-card">
        <div class="loading-state" id="loadingState">
          <div class="spinner-dark"></div>
          <p>Loading your progress...</p>
        </div>

        <div class="empty-state" id="emptyState" style="display: none;">
          <i data-lucide="inbox"></i>
          <p>You haven't attempted any quiz yet. Join one above!</p>
        </div>

        <table class="table" id="attemptsTable" style="display: none;">
          <thead>
            <tr>
              <th>Topic</th>
              <th>Difficulty</th>
              <th>Score</th>
              <th>Status</th>
              <th>Date</th>
            </tr>
          </thead>
          <tbody id="attemptsBody"></tbody>
        </table>
      </div>

    </main>

  </div>

  <script src="../js/config.js"></script>
  <script>
    lucide.createIcons();

    // Auth check
    const token = getToken("student");
    const user = getUser("student");

    if (!token || !user) {
      window.location.href = "login.html";
    } else {
      const firstName = user.name.split(" ")[0];
      document.getElementById("greeting").textContent = `Welcome, ${firstName}`;
      document.getElementById("userName").textContent = user.name;
      document.getElementById("userEmail").textContent = user.studentId;
      document.getElementById("userAvatar").textContent = user.name.charAt(0).toUpperCase();
    }

    // Logout
    document.getElementById("logoutBtn").addEventListener("click", () => {
      logout("student");
    });

    // ---- JOIN QUIZ ----
    const joinForm = document.getElementById("joinForm");
    const quizInput = document.getElementById("quizInput");

    joinForm.addEventListener("submit", (e) => {
      e.preventDefault();

      const input = quizInput.value.trim();
      if (!input) return;

      let code = input;

      // Agar URL hai to ?code= extract karo
      if (input.includes("code=")) {
        const match = input.match(/code=([a-zA-Z0-9]+)/);
        if (match) code = match[1];
      } else if (input.includes("/")) {
        // Agar URL hai lekin code= nahi (galat link)
        showAlert("alertBox", "Invalid link. Make sure it contains '?code='", "error");
        return;
      }

      if (!code || code.length < 4) {
        showAlert("alertBox", "Invalid quiz code", "error");
        return;
      }

      // Quiz page pe redirect
      window.location.href = `quiz.html?code=${code}`;
    });

    // ---- LOAD PROGRESS ----
    async function loadProgress() {
      const loading = document.getElementById("loadingState");
      const empty = document.getElementById("emptyState");
      const table = document.getElementById("attemptsTable");
      const tbody = document.getElementById("attemptsBody");

      loading.style.display = "block";
      empty.style.display = "none";
      table.style.display = "none";

      try {
        const data = await apiCall("/quiz/my-progress", "GET", null, "student");
        const attempts = data.attempts || [];

        loading.style.display = "none";

        if (attempts.length === 0) {
          empty.style.display = "block";
          updateStats([]);
          return;
        }

        // Rows
        tbody.innerHTML = attempts.map((a) => {
          const pct = a.total > 0 ? (a.score / a.total) * 100 : 0;
          let scoreClass = "low";
          if (pct >= 70) scoreClass = "good";
          else if (pct >= 40) scoreClass = "mid";

          const statusBadge =
            a.status === "completed"
              ? '<span class="badge badge-success">Completed</span>'
              : a.status === "auto-submitted"
              ? '<span class="badge badge-warning">Auto-Submitted</span>'
              : '<span class="badge badge-info">Started</span>';

          const date = new Date(a.date).toLocaleDateString("en-GB", {
            day: "2-digit", month: "short", year: "numeric",
          });

          return `
            <tr>
              <td><strong>${a.topic}</strong></td>
              <td><span class="badge badge-info">${a.difficulty}</span></td>
              <td><span class="score-cell ${scoreClass}">${a.score}/${a.total}</span></td>
              <td>${statusBadge}</td>
              <td>${date}</td>
            </tr>
          `;
        }).join("");

        table.style.display = "table";
        updateStats(attempts);
        lucide.createIcons();
      } catch (error) {
        loading.innerHTML = `<p style="color: var(--danger);">Failed to load: ${error.message}</p>`;
      }
    }

    function updateStats(attempts) {
      if (attempts.length === 0) {
        document.getElementById("totalAttempts").textContent = "0";
        document.getElementById("avgScore").textContent = "0%";
        document.getElementById("bestScore").textContent = "0%";
        return;
      }

      const total = attempts.length;
      const percentages = attempts.map(a => a.total > 0 ? (a.score / a.total) * 100 : 0);
      const avg = Math.round(percentages.reduce((s, p) => s + p, 0) / total);
      const best = Math.round(Math.max(...percentages));

      document.getElementById("totalAttempts").textContent = total;
      document.getElementById("avgScore").textContent = `${avg}%`;
      document.getElementById("bestScore").textContent = `${best}%`;
    }

    // Load
    if (token && user) {
      loadProgress();
    }
  </script>

</body>
</html>
</file>

