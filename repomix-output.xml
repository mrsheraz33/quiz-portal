          </div>
          <div class="mini-stat-info">
            <div class="mini-stat-value" id="statStudents">0</div>
            <div class="mini-stat-label">Unique Students</div>
          </div>
        </div>

        <div class="mini-stat">
          <div class="mini-stat-icon green">
            <i data-lucide="file-check"></i>
          </div>
          <div class="mini-stat-info">
            <div class="mini-stat-value" id="statAttempts">0</div>
            <div class="mini-stat-label">Total Attempts</div>
          </div>
        </div>

        <div class="mini-stat">
          <div class="mini-stat-icon amber">
            <i data-lucide="percent"></i>
          </div>
          <div class="mini-stat-info">
            <div class="mini-stat-value" id="statAvg">0%</div>
            <div class="mini-stat-label">Average Score</div>
          </div>
        </div>
      </div>

      <!-- TABLE -->
      <div class="table-card" id="tableCard">

        <div class="loading-state" id="loadingState">
          <div class="spinner-dark"></div>
          <p>Loading records...</p>
        </div>

        <div class="empty-state" id="emptyState" style="display: none;">
          <i data-lucide="inbox"></i>
          <h3>No records yet</h3>
          <p>Once students attempt your quizzes, their results will appear here</p>
        </div>

        <table class="table" id="recordsTable" style="display: none;">
          <thead>
            <tr>
              <th>Student</th>
              <th>Quiz Topic</th>
              <th>Difficulty</th>
              <th>Score</th>
              <th>Status</th>
              <th>Date</th>
            </tr>
          </thead>
          <tbody id="recordsBody"></tbody>
        </table>

      </div>

    </main>

  </div>

  <script src="../js/config.js"></script>
  <script>
    lucide.createIcons();

    // Auth check
    const token = getToken("teacher");
    const user = getUser("teacher");

    if (!token || !user) {
      window.location.href = "login.html";
    } else {
      document.getElementById("userName").textContent = user.name;
      document.getElementById("userEmail").textContent = user.email;
      document.getElementById("userAvatar").textContent = user.name.charAt(0).toUpperCase();
    }

    // Logout
    document.getElementById("logoutBtn").addEventListener("click", () => {
      logout("teacher");
    });

    // Load records
    async function loadRecords() {
      const loading = document.getElementById("loadingState");
      const empty = document.getElementById("emptyState");
      const table = document.getElementById("recordsTable");
      const tbody = document.getElementById("recordsBody");

      loading.style.display = "block";
      empty.style.display = "none";
      table.style.display = "none";

      try {
        const data = await apiCall("/quiz/records", "GET", null, "teacher");
        const records = data.records || [];

        loading.style.display = "none";

        if (records.length === 0) {
          empty.style.display = "block";
          updateStats([]);
          return;
        }

        // Build rows
        tbody.innerHTML = records.map((r) => {
          const percentage = r.total > 0 ? (r.score / r.total) * 100 : 0;
          let scoreClass = "low";
          if (percentage >= 70) scoreClass = "good";
          else if (percentage >= 40) scoreClass = "mid";

          const statusBadge =
            r.status === "completed"
              ? '<span class="badge badge-success">Completed</span>'
              : r.status === "auto-submitted"
              ? '<span class="badge badge-warning">Auto-Submitted</span>'
              : '<span class="badge badge-info">Started</span>';

          const initial = (r.studentName || "?").charAt(0).toUpperCase();
          const date = new Date(r.date).toLocaleDateString("en-GB", {
            day: "2-digit",
            month: "short",
            year: "numeric",
          });

          return `
            <tr>
              <td>
                <div class="student-cell">
                  <div class="student-avatar-sm">${initial}</div>
                  <div class="student-info">
                    <span class="student-name">${r.studentName}</span>
                    <span class="student-id">${r.studentId}</span>
                  </div>
                </div>
              </td>
              <td>${r.topic}</td>
              <td><span class="badge badge-info">${r.difficulty}</span></td>
              <td><span class="score-cell ${scoreClass}">${r.score}/${r.total}</span></td>
              <td>${statusBadge}</td>
              <td>${date}</td>
            </tr>
          `;
        }).join("");

        table.style.display = "table";
        updateStats(records);
        lucide.createIcons();
      } catch (error) {
        loading.innerHTML = `<p style="color: var(--danger);">Failed to load: ${error.message}</p>`;
      }
    }

    function updateStats(records) {
      if (records.length === 0) {
        document.getElementById("statStudents").textContent = "0";
        document.getElementById("statAttempts").textContent = "0";
        document.getElementById("statAvg").textContent = "0%";
        return;
      }

      const uniqueStudents = new Set(records.map((r) => r.studentId)).size;
      const totalAttempts = records.length;
      const totalPct = records.reduce((sum, r) => {
        return sum + (r.total > 0 ? (r.score / r.total) * 100 : 0);
      }, 0);
      const avg = Math.round(totalPct / records.length);

      document.getElementById("statStudents").textContent = uniqueStudents;
      document.getElementById("statAttempts").textContent = totalAttempts;
      document.getElementById("statAvg").textContent = `${avg}%`;
    }

    // Refresh button
    document.getElementById("refreshBtn").addEventListener("click", loadRecords);

    // Initial load
    loadRecords();
  </script>

</body>
</html>
